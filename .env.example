# =============================================================================
# Rafræn Þjónusta — stillingar
#
# Afritaðu þessa skrá í `.env` og fylltu út. Allt sem er ekki fyllt út fer í
# ÞURRKEYRSLU: kerfið skráir allt eins og venjulega en sendir ekkert út. Þannig
# er hægt að prófa allt kerfið áður en nokkur reikningur er stofnaður.
# =============================================================================

# --- Grunnstillingar ---------------------------------------------------------

NODE_ENV=development
PORT=8080
HOST=0.0.0.0

# Opinber slóð þjónsins. Verður að vera https:// í rekstri — session-kökur eru
# merktar Secure og Google hafnar öðrum redirect-slóðum.
BASE_URL=http://localhost:8080

# Hvar gagnagrunnur og vefsíður eru geymd.
DATA_DIR=./data

# --- Öryggi ------------------------------------------------------------------

# NAUÐSYNLEGT í rekstri. Býr til dulkóðunarlykil fyrir aðgangslykla þriðja aðila
# og undirritunarlykil fyrir setur. Ef þessu er breytt tapast innskráningar og
# geymdir Google-lyklar (hægt er að tengja aftur).
#
#   openssl rand -hex 32
#
APP_SECRET=

# Stjórnandi kerfisins. Aðeins einn aðgangur er til — þinn.
# Notað af `npm run setup`; má sleppa og slá inn í staðinn.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
SESSION_TTL_HOURS=12

# --- Google Calendar ---------------------------------------------------------
#
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application). Bættu redirect-slóðinni hér að neðan við „Authorized
# redirect URIs“. Kveiktu líka á Google Calendar API fyrir verkefnið.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback

# --- Tölvupóstur (SMTP) ------------------------------------------------------
#
# Gmail / Google Workspace:  smtp.gmail.com, port 587, app-lykilorð (ekki
#                            venjulegt lykilorð — búið til á myaccount.google.com).
# Proton Mail:               notaðu Proton Mail Bridge, 127.0.0.1 port 1025.
# Annað:                     hvaða SMTP-þjónn sem er.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_IMPLICIT_TLS=false
SMTP_FROM_NAME=Rafræn Þjónusta
SMTP_FROM_EMAIL=

# --- Símsvörun og SMS (Twilio) ----------------------------------------------
#
# console.twilio.com → Account Info. Símanúmerið verður að styðja bæði Voice og
# SMS. Vefkrókaslóðir fyrir hvern viðskiptavin birtast í stjórnborðinu.

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Staðfestir undirskrift Twilio á vefkrókum. Slökktu aðeins á þessu við
# staðbundnar prófanir — símsvarinn getur stofnað bókanir.
TWILIO_VALIDATE_SIGNATURE=true

# --- Snjallsímatilkynningar (Expo) ------------------------------------------

PUSH_ENABLED=true
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
# Aðeins ef Expo-verkefnið krefst auðkenningar á push.
EXPO_ACCESS_TOKEN=

# --- Gervigreind -------------------------------------------------------------
#
# Notuð fyrir tillögur þegar viðskiptavinur lýsir því sem hann vill með eigin
# orðum (t.d. naglaútlit), og fyrir texta á vefsíðum. Án lykils eru notaðar
# tilbúnar tillögur — bókun stöðvast aldrei þótt þetta vanti.

ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Vefhýsing (Vercel) ------------------------------------------------------
#
# Setur myndaðar vefsíður viðskiptavina í loftið á eigin léni. Án lykils eru
# síðurnar áfram smíðaðar og aðgengilegar héðan á /v/<slug>.
# Lykill: vercel.com/account/tokens

VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_PREFIX=rth

# --- Bókanir -----------------------------------------------------------------

DEFAULT_TIMEZONE=Atlantic/Reykjavik
SLOT_GRANULARITY_MIN=15
MAX_ADVANCE_DAYS=90
REMINDER_HOURS_BEFORE=24
WORKER_INTERVAL_SEC=60

# --- Skráning ----------------------------------------------------------------

LOG_LEVEL=info
